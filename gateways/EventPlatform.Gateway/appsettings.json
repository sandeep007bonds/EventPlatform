{
  "ReverseProxy": {
    "Clusters": {
      "catalog": {
        "Destinations": {
          "d1": { "Address": "http://catalog" }
        }
      },
      "inventory": {
        "Destinations": {
          "d1": { "Address": "http://inventory" }
        }
      },
      "ordering": {
        "Destinations": {
          "d1": { "Address": "http://ordering" }
        }
      },
      "ticketing": {
        "Destinations": {
          "d1": { "Address": "http://ticketing" }
        }
      },
      "media": {
        "Destinations": {
          "d1": { "Address": "http://media" }
        }
      },
      "identity": {
        "Destinations": {
          "d1": { "Address": "http://identity" }
        }
      },
      "queue": {
        "Destinations": {
          "d1": { "Address": "http://queue" }
        }
      }
    },
    "Routes": {
      "catalog-events": {
        "ClusterId": "catalog",
        "Match": { "Path": "/api/catalog/v1/events" },
        "Transforms": [ { "PathRemovePrefix": "/api/catalog" } ]
      },
      "catalog-events-by-id": {
        "ClusterId": "catalog",
        "Match": { "Path": "/api/catalog/v1/events/{id}" },
        "Transforms": [ { "PathRemovePrefix": "/api/catalog" } ]
      },
      "catalog-events-publish": {
        "ClusterId": "catalog",
        "Match": { "Path": "/api/catalog/v1/events/{id}/publish" },
        "Transforms": [ { "PathRemovePrefix": "/api/catalog" } ]
      },
      "catalog-events-seatmap": {
        "ClusterId": "catalog",
        "Match": { "Path": "/api/catalog/v1/events/{id}/seatmap" },
        "Transforms": [ { "PathRemovePrefix": "/api/catalog" } ]
      },
      "catalog-events-seatmap-sections": {
        "ClusterId": "catalog",
        "Match": { "Path": "/api/catalog/v1/events/{id}/seatmap/sections", "Methods": [ "POST" ] },
        "Transforms": [ { "PathRemovePrefix": "/api/catalog" } ]
      },
      "catalog-events-details": {
        "ClusterId": "catalog",
        "Match": { "Path": "/api/catalog/v1/events/{id}/details", "Methods": [ "PUT" ] },
        "Transforms": [ { "PathRemovePrefix": "/api/catalog" } ]
      },
      "catalog-event-groups": {
        "ClusterId": "catalog",
        "Match": { "Path": "/api/catalog/v1/event-groups" },
        "Transforms": [ { "PathRemovePrefix": "/api/catalog" } ]
      },
      "catalog-event-groups-by-id": {
        "ClusterId": "catalog",
        "Match": { "Path": "/api/catalog/v1/event-groups/{id}", "Methods": [ "GET" ] },
        "Transforms": [ { "PathRemovePrefix": "/api/catalog" } ]
      },
      "catalog-entry-gates": {
        "ClusterId": "catalog",
        "Match": { "Path": "/api/catalog/v1/events/{eventId}/entry-gates", "Methods": [ "GET", "POST" ] },
        "Transforms": [ { "PathRemovePrefix": "/api/catalog" } ]
      },
      "inventory-count": {
        "ClusterId": "inventory",
        "Match": { "Path": "/api/inventory/v1/events/{eventId}/inventory" },
        "Transforms": [ { "PathRemovePrefix": "/api/inventory" } ]
      },
      "inventory-seats": {
        "ClusterId": "inventory",
        "Match": { "Path": "/api/inventory/v1/events/{eventId}/inventory/seats" },
        "Transforms": [ { "PathRemovePrefix": "/api/inventory" } ]
      },
      "inventory-general-admission": {
        "ClusterId": "inventory",
        "Match": { "Path": "/api/inventory/v1/events/{eventId}/inventory/general-admission" },
        "Transforms": [ { "PathRemovePrefix": "/api/inventory" } ]
      },
      "inventory-block": {
        "ClusterId": "inventory",
        "Match": { "Path": "/api/inventory/v1/events/{eventId}/inventory/block" },
        "Transforms": [ { "PathRemovePrefix": "/api/inventory" } ]
      },
      "inventory-unblock": {
        "ClusterId": "inventory",
        "Match": { "Path": "/api/inventory/v1/events/{eventId}/inventory/unblock" },
        "Transforms": [ { "PathRemovePrefix": "/api/inventory" } ]
      },
      "inventory-holds-create": {
        "ClusterId": "inventory",
        "Match": { "Path": "/api/inventory/v1/holds/", "Methods": [ "POST" ] },
        "Transforms": [ { "PathRemovePrefix": "/api/inventory" } ]
      },
      "inventory-holds-by-id": {
        "ClusterId": "inventory",
        "Match": { "Path": "/api/inventory/v1/holds/{holdId}", "Methods": [ "GET", "DELETE" ] },
        "Transforms": [ { "PathRemovePrefix": "/api/inventory" } ]
      },
      "ordering-checkout": {
        "ClusterId": "ordering",
        "Match": { "Path": "/api/ordering/v1/checkout" },
        "Transforms": [ { "PathRemovePrefix": "/api/ordering" } ]
      },
      "ordering-orders-list": {
        "ClusterId": "ordering",
        "Match": { "Path": "/api/ordering/v1/orders", "Methods": [ "GET" ] },
        "Transforms": [ { "PathRemovePrefix": "/api/ordering" } ]
      },
      "ordering-orders-by-id": {
        "ClusterId": "ordering",
        "Match": { "Path": "/api/ordering/v1/orders/{id}" },
        "Transforms": [ { "PathRemovePrefix": "/api/ordering" } ]
      },
      "ticketing-order-tickets": {
        "ClusterId": "ticketing",
        "Match": { "Path": "/api/ticketing/v1/orders/{orderId}/tickets" },
        "Transforms": [ { "PathRemovePrefix": "/api/ticketing" } ]
      },
      "ticketing-event-tickets": {
        "ClusterId": "ticketing",
        "Match": { "Path": "/api/ticketing/v1/events/{eventId}/tickets" },
        "Transforms": [ { "PathRemovePrefix": "/api/ticketing" } ]
      },
      "ticketing-tickets-scan": {
        "ClusterId": "ticketing",
        "Match": { "Path": "/api/ticketing/v1/tickets/scan", "Methods": [ "POST" ] },
        "Transforms": [ { "PathRemovePrefix": "/api/ticketing" } ]
      },
      "ticketing-ticket-by-id": {
        "ClusterId": "ticketing",
        "Match": { "Path": "/api/ticketing/v1/tickets/{id}" },
        "Transforms": [ { "PathRemovePrefix": "/api/ticketing" } ]
      },
      "ticketing-ticket-qrcode": {
        "ClusterId": "ticketing",
        "Match": { "Path": "/api/ticketing/v1/tickets/{id}/qrcode", "Methods": [ "GET" ] },
        "Transforms": [ { "PathRemovePrefix": "/api/ticketing" } ]
      },
      "media-images": {
        "ClusterId": "media",
        "Match": { "Path": "/api/media/v1/media/images", "Methods": [ "POST" ] },
        "Transforms": [ { "PathRemovePrefix": "/api/media" } ]
      },
      "identity-otp-request": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/identity/v1/otp/request", "Methods": [ "POST" ] },
        "Transforms": [ { "PathRemovePrefix": "/api/identity" } ]
      },
      "identity-otp-verify": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/identity/v1/otp/verify", "Methods": [ "POST" ] },
        "Transforms": [ { "PathRemovePrefix": "/api/identity" } ]
      },
      "identity-organizer-register": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/identity/v1/organizers/register", "Methods": [ "POST" ] },
        "Transforms": [ { "PathRemovePrefix": "/api/identity" } ]
      },
      "identity-organizer-login": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/identity/v1/organizers/login", "Methods": [ "POST" ] },
        "Transforms": [ { "PathRemovePrefix": "/api/identity" } ]
      },
      "queue-join": {
        "ClusterId": "queue",
        "Match": { "Path": "/api/queue/v1/events/{eventId}/queue/join", "Methods": [ "POST" ] },
        "Transforms": [ { "PathRemovePrefix": "/api/queue" } ]
      },
      "queue-status": {
        "ClusterId": "queue",
        "Match": { "Path": "/api/queue/v1/events/{eventId}/queue/status", "Methods": [ "GET" ] },
        "Transforms": [ { "PathRemovePrefix": "/api/queue" } ]
      },
      "queue-settings": {
        "ClusterId": "queue",
        "Match": { "Path": "/api/queue/v1/events/{eventId}/queue/settings", "Methods": [ "GET", "PUT" ] },
        "Transforms": [ { "PathRemovePrefix": "/api/queue" } ]
      }
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
