# Copy to .env.development.local (git-ignored) for local development.
# The gateway's base URL — the frontend never calls a backend service directly.
VITE_GATEWAY_BASE_URL=http://localhost:5090

# Stripe publishable key (pk_test_... / pk_live_...) — safe to expose client-side.
# Leave unset for local dev without Stripe: checkout falls back to a canned test
# payment method and skips rendering the card field entirely.
VITE_STRIPE_PUBLISHABLE_KEY=
