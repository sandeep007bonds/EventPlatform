<Project>

  <!--
    Central Package Management (CPM). ALL NuGet versions are pinned here — never
    put a Version="" on a <PackageReference> in a .csproj.

    NOTE: the versions below are a starting set to be confirmed/updated at scaffold
    time (pin the latest stable that targets .NET 10). Grouped by purpose.
    Licence check required before adding: MediatR, AutoMapper, and MassTransit are
    now commercially licensed — prefer free alternatives or budget accordingly.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!--
      Transitive pinning is intentionally OFF: it forces NuGet to pin every transitive
      package, which conflicts with large tooling trees (e.g. EF Core Design -> MSBuild/Roslyn)
      and breaks restore. To force a fixed version of a vulnerable transitive, add a DIRECT
      PackageReference to it in the project that pulls it (see EventPlatform.Hosting).
    -->
  </PropertyGroup>

  <ItemGroup Label="Analyzers">
    <PackageVersion Include="StyleCop.Analyzers" Version="1.2.0-beta.556" />
    <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.6.0.109712" />
  </ItemGroup>

  <ItemGroup Label="Runtime / framework (.NET 10)">
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup Label="ASP.NET Core / API (used by EventPlatform.Hosting)">
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.0.0" />
  </ItemGroup>

  <ItemGroup Label="Identity (JWT/OIDC issuer)">
    <!-- Same version family Microsoft.AspNetCore.Authentication.JwtBearer 10.0.0 already pulls
         transitively for token validation — pinned explicitly here since Identity.Infrastructure
         uses them directly to MINT and sign tokens (RsaSecurityKey, JwtSecurityTokenHandler),
         not just validate. MIT-licensed, no licence conflict. -->
    <PackageVersion Include="Microsoft.IdentityModel.Tokens" Version="8.4.0" />
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.4.0" />
    <!-- PasswordHasher<TUser> only — NOT the full Microsoft.AspNetCore.Identity cookie/UI/EF-store
         stack (ADR-0023). Part of the MIT-licensed ASP.NET Core repo, versioned to match the
         10.0.0 shared framework. -->
    <PackageVersion Include="Microsoft.Extensions.Identity.Core" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup Label="Platform / infra">
    <PackageVersion Include="Dapr.Client" Version="1.15.0" />
    <PackageVersion Include="Dapr.AspNetCore" Version="1.15.0" />
    <PackageVersion Include="Dapr.Workflow" Version="1.15.0" />
    <PackageVersion Include="StackExchange.Redis" Version="2.8.16" />
    <PackageVersion Include="Stripe.net" Version="47.0.0" />
    <PackageVersion Include="FluentValidation" Version="11.10.0" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="11.10.0" />
  </ItemGroup>

  <ItemGroup Label="Communication (Email/SMS/WhatsApp providers)">
    <!-- All MIT/BSD — no licensing conflict (unlike MediatR/AutoMapper/MassTransit above). -->
    <PackageVersion Include="Azure.Communication.Email" Version="1.1.0" />
    <PackageVersion Include="Azure.Communication.Sms" Version="1.0.2" />
    <PackageVersion Include="Azure.Communication.Messages" Version="1.1.0" />
    <PackageVersion Include="Twilio" Version="7.14.9" />
    <PackageVersion Include="Scriban" Version="7.2.6" />
  </ItemGroup>

  <ItemGroup Label="Gateway (YARP reverse proxy)">
    <PackageVersion Include="Yarp.ReverseProxy" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup Label="Media storage">
    <!-- MIT-licensed — no licensing conflict. -->
    <PackageVersion Include="Azure.Storage.Blobs" Version="12.29.1" />
  </ItemGroup>

  <ItemGroup Label="Catalog (HTML sanitising for organizer-authored policy documents)">
    <!--
      MIT-licensed. Whitelist-based: it parses with AngleSharp and keeps only known-safe tags and
      attributes, rather than pattern-matching for known-bad ones — which is the difference between
      a sanitiser and a filter someone will get past.

      Do not drop below 9.2: 9.0.886 carries GHSA-j92c-7v7g-gj3f (moderate), which NU1902 turns
      into a build error here. Ironic in a sanitiser and exactly why the version is pinned centrally.
    -->
    <PackageVersion Include="HtmlSanitizer" Version="9.2.1039" />
  </ItemGroup>

  <ItemGroup Label="Ticketing (QR code generation)">
    <!-- MIT-licensed, pure-managed, no native/WASM dependency. -->
    <PackageVersion Include="QRCoder" Version="1.8.0" />
  </ItemGroup>

  <ItemGroup Label="Application (in-process mediator)">
    <!-- Pinned to the last Apache/OSS release; do NOT bump to 13.x (commercial). See ADR-0014. -->
    <PackageVersion Include="MediatR" Version="12.5.0" />
    <PackageVersion Include="MediatR.Contracts" Version="2.0.1" />
  </ItemGroup>

  <ItemGroup Label="Observability (OpenTelemetry)">
    <PackageVersion Include="OpenTelemetry.Api" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
  </ItemGroup>

  <ItemGroup Label="Security fix for a vulnerable transitive (direct ref in EventPlatform.Hosting)">
    <!-- CVE-2026-49451 (stack-overflow DoS) — fixed in 2.7.5. Pulled by Microsoft.AspNetCore.OpenApi. -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.7.5" />
    <!-- System.Security.Cryptography.Xml is framework-provided on .NET 10 (pruned) — not pinned/referenced. -->
  </ItemGroup>

  <ItemGroup Label="Testing">
    <!-- Concrete config package (ConfigurationBuilder/AddInMemoryCollection) — services only ever
         depend on Microsoft.Extensions.Configuration.Abstractions; this is test-only. -->
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.0" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.0.0" />
    <PackageVersion Include="Testcontainers.Redis" Version="4.0.0" />
    <PackageVersion Include="Testcontainers.Azurite" Version="4.0.0" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="Shouldly" Version="4.2.1" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
  </ItemGroup>

</Project>
