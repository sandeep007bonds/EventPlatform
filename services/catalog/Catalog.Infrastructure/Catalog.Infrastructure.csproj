<Project Sdk="Microsoft.NET.Sdk">

  <!-- Infrastructure: EF Core (PostgreSQL) persistence and adapters. Implements the
       Application's abstractions and owns the transactional outbox. -->

  <PropertyGroup>
    <RootNamespace>Catalog.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Catalog.Domain/Catalog.Domain.csproj" />
    <ProjectReference Include="../Catalog.Application/Catalog.Application.csproj" />
    <ProjectReference Include="../../../building-blocks/EventPlatform.Messaging/EventPlatform.Messaging.csproj" />
    <ProjectReference Include="../../../building-blocks/EventPlatform.Persistence/EventPlatform.Persistence.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- Sanitises organizer-authored policy HTML on write; see PolicyHtmlSanitizer. -->
    <PackageReference Include="HtmlSanitizer" />
    <!-- Dapr.Client: reads seat-map versions from the Venue service (DaprVenueClient). Catalog's
         only outbound service invocation — everything else it needs, it owns. -->
    <PackageReference Include="Dapr.Client" />
    <!-- Migrations live here (tracker T8). PrivateAssets=all keeps the Design tooling tree out of
         the API host and any downstream consumer; on .NET 10 its framework transitives are pruned. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

</Project>
