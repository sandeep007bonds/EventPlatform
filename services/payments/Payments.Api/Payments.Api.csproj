<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Payments.Api</RootNamespace>
    <!-- Enables `dotnet user-secrets` for local secrets (e.g. the Stripe key). The id is not a
         secret; the values live in the user's secret store, outside the repo. -->
    <UserSecretsId>eventplatform-payments</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Payments.Application/Payments.Application.csproj" />
    <ProjectReference Include="../Payments.Infrastructure/Payments.Infrastructure.csproj" />
    <ProjectReference Include="../../../building-blocks/EventPlatform.Hosting/EventPlatform.Hosting.csproj" />
    <ProjectReference Include="../../../building-blocks/EventPlatform.Contracts/EventPlatform.Contracts.csproj" />
  </ItemGroup>

</Project>
