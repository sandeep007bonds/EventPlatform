<Project Sdk="Microsoft.NET.Sdk">

  <!-- Infrastructure: EF Core (PostgreSQL) persistence and the transactional outbox.
       Migrations live here (tracker T8). -->

  <PropertyGroup>
    <RootNamespace>Ticketing.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Ticketing.Domain/Ticketing.Domain.csproj" />
    <ProjectReference Include="../Ticketing.Application/Ticketing.Application.csproj" />
    <ProjectReference Include="../../../building-blocks/EventPlatform.Messaging/EventPlatform.Messaging.csproj" />
    <ProjectReference Include="../../../building-blocks/EventPlatform.Persistence/EventPlatform.Persistence.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- PrivateAssets=all keeps the Design tooling tree out of the API host. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <!-- Live scan-time reads of Catalog (event/seatmap) and Inventory (GA allocations). -->
    <PackageReference Include="Dapr.Client" />
  </ItemGroup>

</Project>
