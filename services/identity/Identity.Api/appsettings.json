{
  "Jwt": {
    "Authority": "https://login.eventplatform.example",
    "Audience": "eventplatform",
    "RequireHttpsMetadata": true
  },
  "Identity": {
    "Jwt": {
      "Issuer": "https://identity.eventplatform.example",
      "Audience": "eventplatform",
      "AccessTokenLifetimeDays": 7
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
