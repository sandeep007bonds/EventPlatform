<Project Sdk="Microsoft.NET.Sdk">

  <!-- Infrastructure: EF Core (PostgreSQL) persistence, OTP hashing, the Dapr call to
       Communication for SMS delivery, and RSA signing-key management / JWT issuance. -->

  <PropertyGroup>
    <RootNamespace>Identity.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Identity.Domain/Identity.Domain.csproj" />
    <ProjectReference Include="../Identity.Application/Identity.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- PrivateAssets=all keeps the Design tooling tree out of the API host. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <PackageReference Include="Dapr.Client" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
  </ItemGroup>

  <!-- Lets Identity.Tests exercise the internal repository/signing classes directly. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Identity.Tests" />
  </ItemGroup>

</Project>
