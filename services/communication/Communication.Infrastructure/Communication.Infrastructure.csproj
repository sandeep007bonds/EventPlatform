<Project Sdk="Microsoft.NET.Sdk">

  <!-- Infrastructure: EF Core (PostgreSQL) persistence, template rendering, and the Email/SMS/
       WhatsApp vendor adapters. No EventPlatform.Messaging reference: this service never publishes
       an integration event, so it has no transactional outbox (see services/communication/CLAUDE.md). -->

  <PropertyGroup>
    <RootNamespace>Communication.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Communication.Domain/Communication.Domain.csproj" />
    <ProjectReference Include="../Communication.Application/Communication.Application.csproj" />
    <ProjectReference Include="../../../building-blocks/EventPlatform.Persistence/EventPlatform.Persistence.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- PrivateAssets=all keeps the Design tooling tree out of the API host. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <PackageReference Include="Azure.Communication.Email" />
    <PackageReference Include="Azure.Communication.Sms" />
    <PackageReference Include="Azure.Communication.Messages" />
    <PackageReference Include="Twilio" />
    <!-- AddHttpClient<T>/IHttpClientFactory for TwilioSmsSender/TwilioWhatsAppSender
         (see services/communication/CLAUDE.md) - was only compiling before via an
         indirect transitive from Scriban 6.2.1; that path disappeared bumping to
         7.2.6 (CS0234), so it needs to be a direct reference like any other type
         this project uses directly. -->
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Scriban" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Templates/Resources/*.txt" />
  </ItemGroup>

  <!-- Lets Communication.Tests exercise the internal senders/template classes directly. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Communication.Tests" />
  </ItemGroup>

</Project>
