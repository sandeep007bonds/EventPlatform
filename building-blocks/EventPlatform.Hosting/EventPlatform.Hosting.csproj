<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Shared service defaults ("ServiceDefaults") referenced by every service's
    Api project. One call to AddServiceDefaults()/UseServiceDefaults() gives
    every service identical auth, OpenAPI, JSON, observability and health wiring.
  -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <RootNamespace>EventPlatform.Hosting</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
  </ItemGroup>

  <!-- Force the patched Microsoft.OpenApi (vulnerable transitive via Microsoft.AspNetCore.OpenApi, CVE-2026-49451).
       Note: System.Security.Cryptography.Xml is framework-provided on .NET 10 (auto-pruned) — do NOT reference it. -->
  <ItemGroup Label="Security override">
    <PackageReference Include="Microsoft.OpenApi" />
  </ItemGroup>

</Project>
