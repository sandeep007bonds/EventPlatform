<Project>

  <!--
    Shared MSBuild settings applied to EVERY project in the monorepo.
    This is where the compile-time golden rules live. Individual projects can
    override where genuinely needed (e.g., test projects relax doc requirements
    via .editorconfig).
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Quality gates: style + analyzers break the build -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>

    <!-- Require XML docs on public API (CS1591 fires on missing docs) -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Central Package Management -->
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>

    <!--
      Audit DIRECT dependencies only (still warnings-as-errors). We keep our own
      references patched (e.g. OpenTelemetry, Microsoft.OpenApi). Deep *design-time*
      tooling transitives — EF Core Design pulls a vulnerable System.Security.Cryptography.Xml
      that never ships (PrivateAssets=all) and can't be pinned (NU1510, framework-provided) —
      are out of scope for the audit.
    -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>direct</NuGetAuditMode>

    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!-- StyleCop settings shared by every project (e.g. don't require docs on internal members). -->
  <ItemGroup>
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)stylecop.json" />
  </ItemGroup>

  <!-- Analyzers applied to every project. Versions come from Directory.Packages.props (CPM). -->
  <ItemGroup>
    <PackageReference Include="StyleCop.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="SonarAnalyzer.CSharp">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
