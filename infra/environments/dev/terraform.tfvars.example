# Copy to terraform.tfvars (git-ignored) and fill in real values.
# Never commit terraform.tfvars.

subscription_id = "00000000-0000-0000-0000-000000000000"
location        = "eastus"

node_count   = 1
node_vm_size = "Standard_B2ms"

postgres_administrator_password = "replace-with-a-strong-password"

# Optional: your own IP so you can reach Postgres directly for debugging.
# Bare IP, not CIDR (e.g. "1.2.3.4", not "1.2.3.4/32").
# dev_ip_cidr = "1.2.3.4"
