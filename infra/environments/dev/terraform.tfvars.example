# Copy to terraform.tfvars (git-ignored) and fill in real values.
# Never commit terraform.tfvars.

subscription_id = "00000000-0000-0000-0000-000000000000"
location        = "eastus"

# Postgres Flexible Server has its own per-subscription region allow-list,
# separate from every other resource here. If `location` gets rejected with
# LocationIsOfferRestricted for Postgres specifically, override just this —
# no need to move AKS/VNet/Key Vault/Redis too. There's no way to know in
# advance which regions your subscription's offer allows; the Azure Portal's
# "Create PostgreSQL Flexible Server" region dropdown greys out restricted
# regions for the logged-in subscription, which is faster than trial-and-error
# via `apply`.
postgres_location = "eastus"

# AKS cluster creation can fail with AKSCapacityHeavyUsage ("Creating a new
# cluster is unavailable at this time in region <x>") — a transient Azure
# capacity throttle on new cluster creation, unrelated to your subscription's
# offer or this config. It clears unpredictably; if retrying `apply` a few
# times doesn't help, override just this to a region with available
# capacity. The networking module (VNet/subnet) follows this value too,
# since AKS requires its VNet to be in the same region as the cluster.
aks_location = "eastus"

node_count   = 1
# Standard_B2ms (burstable, cheapest) isn't available on every subscription's
# allowed-SKU list. If yours rejects it (a 400 on `terraform apply` naming the
# SKU), check the error's list of allowed sizes and pick the smallest
# general-purpose one — Standard_D2s_v7 is this repo's current default.
node_vm_size = "Standard_D2s_v7"

postgres_administrator_password = "replace-with-a-strong-password"

# Set false if `apply` fails on the azuread_* resources with a 403
# Authorization_RequestDenied / "Insufficient privileges to complete the
# operation". Those create an app registration + service principal in
# Microsoft Entra ID, which needs *directory* permissions — a completely
# separate grant from your role on the subscription, so being subscription
# Owner does not give you them. Nothing else in this environment is affected:
# the cluster, databases, Key Vault and ACR all still apply. Only CI's
# image-push identity is skipped; see infra/README.md for the two ways to
# give CD a push identity without directory rights.
# enable_github_oidc = false

# Only needed when your sign-in home tenant differs from the tenant that owns
# subscription_id — e.g. you have guest access to someone else's directory.
# Leave unset and the azuread provider follows the CLI's home tenant, which
# silently targets the wrong directory in that case. Get the right value with
#   az account show --query tenantId -o tsv
# entra_tenant_id = "00000000-0000-0000-0000-000000000000"

# Only needed if you fork/rename the repo - github_repository must exactly
# match the repo running .github/workflows/cd.yaml, or GitHub Actions' OIDC
# login will fail with a federated-credential mismatch.
# github_repository    = "sandeep007bonds/EventPlatform"
# github_oidc_branches = ["main", "claude/enterprise-ticket-platform-w3opb0"]

# Optional: your own IP so you can reach Postgres directly for debugging.
# Bare IP, not CIDR (e.g. "1.2.3.4", not "1.2.3.4/32").
# dev_ip_cidr = "1.2.3.4"

# Hard daily ingestion cap for Log Analytics, in GB. The default (0.15) keeps a month's ingestion
# inside Azure Monitor's 5 GB free grant. Past the cap Azure stops ingesting for the rest of the
# UTC day and that data is lost — raise this only if you would rather pay than lose logs.
# log_analytics_daily_quota_gb = 0.15

# REQUIRED. Contact address registered with Let's Encrypt for the cluster's TLS certificate. Used
# only for expiry/account notices - never published, never in the certificate itself.
letsencrypt_email = "you@example.com"

# Optional: switch to Let's Encrypt staging while debugging the ingress. Staging certificates are
# untrusted (the browser warns) but its rate limits are far looser than production's 5 identical
# certificates per week, which is easy to burn through while iterating.
# letsencrypt_server = "https://acme-staging-v02.api.letsencrypt.org/directory"

# Optional: a recognisable DNS label instead of one derived from this environment's random suffix.
# Becomes <label>.<aks_location>.cloudapp.azure.com and must be globally unique within the region.
# ingress_dns_label = "eventplatform-yourname"

# Optional: serve the gateway on a domain you own instead of the free Azure FQDN. You must point
# its CNAME at `terraform output azure_ingress_fqdn` BEFORE applying - cert-manager proves control
# of the name over HTTP, so issuance fails until that record resolves.
# custom_domain = "api.example.com"
