# EventPlatform — editorconfig
# Enforces the code-style golden rules. Paired with Directory.Build.props
# (TreatWarningsAsErrors=true), these severities break the build.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{cs,csx}]
indent_size = 4
max_line_length = 120

# --- Language conventions ---
csharp_style_namespace_declarations = file_scoped:error
csharp_using_directive_placement = outside_namespace:warning   # required for file-scoped namespaces + global usings
csharp_prefer_braces = true:warning
dotnet_sort_system_directives_first = true
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
csharp_style_var_when_type_is_apparent = true:suggestion

# --- Nullable / quality ---
dotnet_diagnostic.CS8600.severity = error   # converting null literal to non-nullable
dotnet_diagnostic.CS8602.severity = error   # possible null dereference
dotnet_diagnostic.CS1591.severity = error   # missing XML doc on public member

# --- StyleCop (SA) key rules ---
dotnet_diagnostic.SA1402.severity = error   # one type per file
dotnet_diagnostic.SA1633.severity = none    # no mandatory file header
dotnet_diagnostic.SA1600.severity = error   # public members documented
dotnet_diagnostic.SA1200.severity = none    # 'using inside namespace' handled above
dotnet_diagnostic.SA0001.severity = none    # XML comment output (docs still enforced via CS1591)
dotnet_diagnostic.SA1101.severity = none    # do NOT require 'this.' prefix (modern C# style)
dotnet_diagnostic.SA1623.severity = none    # do NOT require 'Gets/Sets' doc prefix on properties
dotnet_diagnostic.SA1642.severity = none    # do NOT require 'Initializes a new instance...' ctor boilerplate
dotnet_diagnostic.SA1309.severity = none    # allow _underscore private fields (modern C# convention)

# --- Code-analysis (CA) adjustments ---
dotnet_diagnostic.CA1716.severity = none    # allow natural domain names like 'Event' (rule targets VB keyword clashes)
dotnet_diagnostic.CA1848.severity = none    # LoggerMessage delegates not required off hot paths (revisit for proven hot paths)
dotnet_diagnostic.CA1873.severity = none    # logging-argument cost rule too noisy for cheap args

# --- SonarAnalyzer (S) adjustments ---
dotnet_diagnostic.S2221.severity = none     # resilient background loops (outbox relay, reaper, saga workers) must catch-all to stay alive

# --- Naming: interfaces prefixed with I, etc. (analyzer defaults) ---
dotnet_naming_rule.interfaces_start_with_i.severity = error
dotnet_naming_rule.interfaces_start_with_i.symbols = interface_symbols
dotnet_naming_rule.interfaces_start_with_i.style = prefix_i
dotnet_naming_symbols.interface_symbols.applicable_kinds = interface
dotnet_naming_style.prefix_i.required_prefix = I
dotnet_naming_style.prefix_i.capitalization = pascal_case

# --- Relax doc/style noise where it adds no value ---

# Test projects: don't require XML docs; allow the idiomatic
# Method_Scenario_ExpectedResult xUnit naming convention (CA1707 otherwise
# forbids underscores in identifiers); allow disposable fields (e.g. a
# Testcontainers container, a DbContext) cleaned up via IAsyncLifetime's
# InitializeAsync/DisposeAsync instead of IDisposable - CA1001 doesn't
# recognize that xUnit-native pattern as valid disposal.
[**/tests/**/*.cs]
dotnet_diagnostic.CS1591.severity = none
dotnet_diagnostic.SA1600.severity = none
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1001.severity = none

# Generated / migrations code: exclude from style.
#
# EF writes these files, and rewrites them on every `migrations add` — so hand-fixing a style
# violation here is undone the next time anyone changes a model. Style rules also have nothing to
# say about generated DDL: whether `migrationBuilder.CreateTable`'s column initializer carries a
# trailing comma is not a code-quality signal.
#
# ALL analyzer diagnostics are silenced, not a list of rule IDs. The first migrations tripped
# IDE0161, SA1413 and CA1861; enumerating those would just move the whack-a-mole to whichever rule
# the next generated file happens to violate. Compiler warnings (CS####) are not analyzer
# diagnostics, so CS1591 still needs its own line.
#
# GLOB: `**.cs`, NOT `**/*.cs`. In `Migrations/**/*.cs` the `/**/` requires at least one
# intermediate directory, so it matches `Migrations/Sub/File.cs` but NOT `Migrations/File.cs` —
# which is exactly where EF puts them. That typo silently disabled this whole section, and the
# first real `migrations add` failed the build with 58 style errors in generated code. `**` matches
# any characters including none and including `/`, so this form covers both depths.
#
# The four style options are re-stated because bulk `dotnet_analyzer_diagnostic.severity` does not
# override a rule that is configured specifically elsewhere, and `option = value:severity` in the
# [*.{cs,csx}] section above is a specific configuration of the matching IDE rule. IDE0161
# (file-scoped namespaces) is the one that actually fires on EF output; the other three are here so
# the next generated file doesn't reopen this.
#
# This does NOT weaken review: a migration is DDL against real data and is reviewed for what it
# does to the schema, not for how it is formatted.
[**/{Migrations,Generated}/**.cs]
generated_code = true
dotnet_analyzer_diagnostic.severity = none
dotnet_diagnostic.CS1591.severity = none
csharp_style_namespace_declarations = file_scoped:none
csharp_using_directive_placement = outside_namespace:none
csharp_prefer_braces = true:none
dotnet_style_require_accessibility_modifiers = for_non_interface_members:none
